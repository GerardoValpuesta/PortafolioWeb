{
  "name": "Bot de Telegram con IA para Gestión de Tareas & Recordatorios Inteligentes",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"]
      },
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "model": "claude-3-5-sonnet-20241022",
        "prompt": "Clasifica la solicitud del usuario: 'crear_evento', 'nueva_tarea' o 'consulta'. Extrae fecha, título y detalles."
      },
      "name": "Claude Intent Parser",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [360, 300]
    },
    {
      "parameters": {
        "calendarId": "primary"
      },
      "name": "Create Google Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 2,
      "position": [620, 200]
    },
    {
      "parameters": {
        "operation": "reply",
        "text": "={{ $json.response }}"
      },
      "name": "Reply Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [880, 300]
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{ "node": "Claude Intent Parser", "type": "main", "index": 0 }]]
    },
    "Claude Intent Parser": {
      "main": [[{ "node": "Create Google Calendar Event", "type": "main", "index": 0 }]]
    },
    "Create Google Calendar Event": {
      "main": [[{ "node": "Reply Telegram", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "author": "Gerardo Nuñez Valpuesta" }
}
