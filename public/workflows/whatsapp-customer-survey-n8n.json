{
  "name": "Encuestador Automático de Satisfacción NPS por WhatsApp con Análisis de Sentimiento",
  "nodes": [
    {
      "parameters": { "path": "nps-response", "httpMethod": "POST" },
      "name": "NPS Response Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "prompt": "Analiza la retroalimentación del cliente. Clasifica la emoción (Satisfecho, Detractor, Neutro) e identifica si requiere llamada urgente."
      },
      "name": "GPT Sentiment Analyzer",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [340, 300]
    },
    {
      "parameters": { "channel": "nps-detractors", "text": "⚠️ Alerta Detractor: {{ $json.text }}" },
      "name": "Alert Customer Success in Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 1,
      "position": [580, 300]
    }
  ],
  "connections": {
    "NPS Response Webhook": { "main": [[{ "node": "GPT Sentiment Analyzer", "type": "main", "index": 0 }]] },
    "GPT Sentiment Analyzer": { "main": [[{ "node": "Alert Customer Success in Slack", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "author": "Gerardo Nuñez Valpuesta" }
}
