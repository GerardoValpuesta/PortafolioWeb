{
  "name": "Enriquecedor de Leads CRM & Sincronización Automática con HubSpot / Salesforce",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-lead"
      },
      "name": "Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "url": "https://api.clearbit.com/v2/companies/find?domain={{ $json.domain }}"
      },
      "name": "Enrich Domain Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [360, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "prompt": "Sintetiza la información de la empresa y califica el lead (A/B/C)."
      },
      "name": "OpenAI Lead Qualifier",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [620, 300]
    },
    {
      "parameters": {
        "resource": "contact",
        "operation": "create"
      },
      "name": "Create HubSpot Contact",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [880, 300]
    }
  ],
  "connections": {
    "Form Webhook": {
      "main": [[{ "node": "Enrich Domain Data", "type": "main", "index": 0 }]]
    },
    "Enrich Domain Data": {
      "main": [[{ "node": "OpenAI Lead Qualifier", "type": "main", "index": 0 }]]
    },
    "OpenAI Lead Qualifier": {
      "main": [[{ "node": "Create HubSpot Contact", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "author": "Gerardo Nuñez Valpuesta" }
}
