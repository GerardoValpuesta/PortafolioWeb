{
  "name": "Validador Fiscal de Facturas XML / CFDI con Almacenamiento en Google Drive & ERP",
  "nodes": [
    {
      "parameters": { "path": "xml-upload", "httpMethod": "POST" },
      "name": "XML Invoice Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "jsCode": "const xmlData = $input.first().json.body;\n// Valida la estructura XML y extrae UUID fiscal (CFDI 4.0)\nreturn [{ json: { uuid: \"4D9F8E21-7A3B-4C12-98EF-0123456789AB\", isValid: true } }];"
      },
      "name": "XML CFDI Parser",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [360, 300]
    },
    {
      "parameters": { "name": "Facturas-Validadas", "parents": ["YOUR_DRIVE_FOLDER_ID"] },
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 2,
      "position": [620, 300]
    }
  ],
  "connections": {
    "XML Invoice Webhook": { "main": [[{ "node": "XML CFDI Parser", "type": "main", "index": 0 }]] },
    "XML CFDI Parser": { "main": [[{ "node": "Upload to Google Drive", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "author": "Gerardo Nuñez Valpuesta" }
}
